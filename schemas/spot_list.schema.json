{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "retrosolver.spot_list.v1",
  "title": "RetroSolver curated spot list (solver INPUTS only - no strategy output)",
  "description": "Enforced by retrosolver_pipeline/spotlist.py (stdlib). CSV equivalent: columns spot_id,ip_position,oop_position,pot,effective_stack,board,range_ip,range_oop,bet_sizes,accuracy_target[,thread_num,max_iteration,print_interval,use_isomorphism,dump_rounds,allin_threshold]; bet_sizes compact form 'street:player:type[:s1/s2]|...'; solver name/version passed on the command line.",
  "type": "object",
  "required": ["schema", "solver", "spots"],
  "properties": {
    "schema": {"const": "retrosolver.spot_list.v1"},
    "list_id": {"type": "string"},
    "notes": {"type": "string"},
    "solver": {"type": "object", "required": ["name", "version"],
               "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}},
               "description": "Exact solver build Instinct runs, e.g. TexasSolver v0.2.0. Copied into every spot of the pack."},
    "defaults": {"$ref": "#/$defs/solver_settings"},
    "spots": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/spot"}}
  },
  "$defs": {
    "range": {"type": "string", "pattern": "^[^\\s]+$",
              "description": "TexasSolver range text: comma-separated hand classes (AA, AKs, AKo, KQ), optional :weight in (0,1]. No spaces."},
    "sizes": {"type": "array", "items": {"type": "number", "exclusiveMinimum": 0}, "description": "Percent of pot"},
    "player_sizes": {"type": "object", "additionalProperties": false,
                     "properties": {"bet": {"$ref": "#/$defs/sizes"}, "raise": {"$ref": "#/$defs/sizes"},
                                    "donk": {"$ref": "#/$defs/sizes"}, "allin": {"type": "boolean"}}},
    "street_sizes": {"type": "object", "additionalProperties": false,
                     "properties": {"oop": {"$ref": "#/$defs/player_sizes"}, "ip": {"$ref": "#/$defs/player_sizes"}}},
    "solver_settings": {"type": "object", "additionalProperties": false, "properties": {
      "thread_num": {"type": "integer", "minimum": 1, "default": 8},
      "max_iteration": {"type": "integer", "minimum": 1, "default": 200},
      "print_interval": {"type": "integer", "minimum": 1, "default": 10},
      "use_isomorphism": {"enum": [0, 1], "default": 1},
      "dump_rounds": {"type": "integer", "minimum": 1, "default": 1},
      "allin_threshold": {"type": "number", "exclusiveMinimum": 0, "default": 0.67}}},
    "spot": {"type": "object", "additionalProperties": false,
      "required": ["spot_id", "positions", "pot", "effective_stack", "board", "ranges", "bet_sizes", "accuracy_target"],
      "properties": {
        "spot_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
        "positions": {"type": "object", "required": ["ip", "oop"], "additionalProperties": false,
                      "properties": {"ip": {"type": "string"}, "oop": {"type": "string"}}},
        "pot": {"type": "number", "exclusiveMinimum": 0},
        "effective_stack": {"type": "number", "exclusiveMinimum": 0},
        "board": {"description": "3-5 distinct cards, 'Qs,Jh,2h' or ['Qs','Jh','2h']",
                  "oneOf": [{"type": "string"}, {"type": "array", "minItems": 3, "maxItems": 5, "items": {"type": "string", "pattern": "^[2-9TJQKA][cdhs]$"}}]},
        "ranges": {"type": "object", "required": ["ip", "oop"], "additionalProperties": false,
                   "properties": {"ip": {"$ref": "#/$defs/range"}, "oop": {"$ref": "#/$defs/range"}}},
        "bet_sizes": {"type": "object", "additionalProperties": false, "minProperties": 1,
                      "properties": {"flop": {"$ref": "#/$defs/street_sizes"}, "turn": {"$ref": "#/$defs/street_sizes"},
                                     "river": {"$ref": "#/$defs/street_sizes"}},
                      "description": "Only streets not yet dealt; the spot's own street is required."},
        "accuracy_target": {"type": "number", "exclusiveMinimum": 0,
                            "description": "TexasSolver set_accuracy: stop when exploitability <= this percent of the pot. Also the extractor's convergence bar."},
        "solver_settings": {"$ref": "#/$defs/solver_settings"},
        "notes": {"type": "string"}}}
  }
}
