{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "retrosolver.spot_pack.v1",
  "title": "RetroSolver spot pack (every strategy number comes from a real solver output file)",
  "description": "Enforced by retrosolver_pipeline/pack.py. pack_hash = sha256 hex of the RFC 8785 (JCS) canonical JSON of the whole pack object with the pack_hash key removed. A spot missing any required field is invalid. Packs with contains_synthetic_test_data must never ship.",
  "type": "object",
  "required": ["schema", "pack_id", "created_at", "generator", "solver", "source_batch_manifest_sha256", "spot_count", "spots", "hash", "pack_hash"],
  "properties": {
    "schema": {"const": "retrosolver.spot_pack.v1"},
    "pack_id": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "generator": {"type": "object", "required": ["name", "version"]},
    "solver": {"$ref": "#/$defs/solver"},
    "source_batch_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "spot_count": {"type": "integer", "minimum": 1},
    "contains_synthetic_test_data": {"const": true, "description": "Present only on unit-test packs. Production loaders must refuse."},
    "hash": {"type": "object", "properties": {"algorithm": {"const": "sha256"}, "canonicalization": {"const": "RFC8785-JCS"}, "scope": {"type": "string"}}},
    "pack_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ev_mode": {"enum": ["full", "frequencies_only"], "description": "full (also assumed when absent): every node has per-action EVs. frequencies_only: stock TexasSolver CLI spots; every node has evs=null. Never mixed within a pack."},
    "spots": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/spot"}}
  },
  "$defs": {
    "solver": {"type": "object", "required": ["name", "version"],
               "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}},
    "vector": {"type": "array", "items": {"type": "number"}},
    "decision_node": {"type": "object", "required": ["path", "player", "actions", "frequencies", "evs"],
      "properties": {
        "path": {"type": "array", "items": {"type": "string"}, "description": "Solver action strings from the root, [] = root"},
        "player": {"enum": ["oop", "ip"]},
        "actions": {"type": "array", "minItems": 1, "items": {"type": "string"}, "description": "Verbatim TexasSolver action strings, e.g. 'CHECK', 'BET 5.000000'"},
        "frequencies": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/vector"},
                        "description": "combo (e.g. AhKd) -> per-action frequency, aligned with actions; each sums to 1"},
        "evs": {"oneOf": [{"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/vector"},
                "description": "combo -> per-action EV, aligned with actions; same combo set as frequencies"},
                {"type": "null", "description": "Only in ev_mode=frequencies_only packs: the solver output had no EVs; nothing is filled in."}]}}},
    "spot": {"type": "object",
      "required": ["spot_id", "positions", "board", "street", "ranges", "pot", "stacks", "bet_sizes", "accuracy_target", "solver", "solver_settings", "run_date", "run_date_source", "convergence", "decision_nodes", "provenance"],
      "properties": {
        "spot_id": {"type": "string"},
        "positions": {"type": "object", "required": ["ip", "oop"]},
        "board": {"type": "array", "minItems": 3, "maxItems": 5, "items": {"type": "string"}},
        "street": {"enum": ["flop", "turn", "river"]},
        "ranges": {"type": "object", "required": ["ip", "oop"]},
        "pot": {"type": "number"},
        "stacks": {"type": "object", "required": ["effective_stack"]},
        "bet_sizes": {"type": "object"},
        "accuracy_target": {"type": "number"},
        "solver": {"$ref": "#/$defs/solver"},
        "solver_settings": {"type": "object"},
        "run_date": {"type": "string", "format": "date-time", "description": "UTC, from run_finished_at.txt written by the runner (fallback: output file mtime)"},
        "run_date_source": {"enum": ["run_finished_at.txt", "output_file_mtime"]},
        "convergence": {"type": "object", "required": ["exploitability_pct_of_pot", "accuracy_target_pct_of_pot", "met_target", "source"],
                        "properties": {"exploitability_pct_of_pot": {"type": "number"}, "met_target": {"const": true},
                                       "source": {"enum": ["tmp_log.txt", "solve_stdout.log"]}, "last_logged_iteration": {"type": "integer"}}},
        "decision_nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/decision_node"}},
        "provenance": {"type": "object", "required": ["input_sha256", "output_sha256", "output_file"]},
        "synthetic_test_data": {"const": true},
        "verification": {"enum": ["single_source", "verified"], "description": "Tagging rule: the extractor writes single_source; only the independent validator may set verified."}}}
  }
}
