{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "retrosolver.spot_pack.v2",
  "title": "RetroSolver spot pack v2: preflop + 6-max + 169-class keying + tagged convergence",
  "description": "Lives alongside retrosolver.spot_pack.v1 (unchanged). Enforced by retrosolver_pipeline/pack_v2.py, which also checks cross-field rules JSON Schema cannot (board length per street, exactly 169 class keys, worst-seat SE = max per-seat SE, SE pct = 100*SE/root pot, frequency sums). pack_hash = sha256 hex of RFC 8785 (JCS) canonical JSON of the pack without pack_hash. Every strategy number comes from a solver output file named in provenance.",
  "type": "object",
  "required": ["schema", "pack_id", "created_at", "generator", "solver", "ev_mode", "source_sha256", "spot_count", "spots", "hash", "pack_hash"],
  "properties": {
    "schema": {"const": "retrosolver.spot_pack.v2"},
    "pack_id": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "generator": {"type": "object", "required": ["name", "version"]},
    "solver": {"$ref": "#/$defs/solver"},
    "ev_mode": {"enum": ["full", "frequencies_only"], "description": "full: every node has per-action EVs. frequencies_only: every node has evs=null (stock TexasSolver CLI; donksolver, which has no per-action EVs)."},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "TexasSolver: batch manifest.json; donksolver: the raw dump file."},
    "spot_count": {"type": "integer", "minimum": 1},
    "contains_synthetic_test_data": {"const": true},
    "hash": {"type": "object"},
    "pack_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "spots": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/spot"}}
  },
  "$defs": {
    "solver": {"type": "object", "required": ["name", "version"], "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}},
    "vector": {"type": "array", "items": {"type": "number"}},
    "seat": {"enum": ["SB", "BB", "UTG", "HJ", "CO", "BTN"]},
    "convergence_se": {"type": "object", "description": "Monte Carlo engines. Copied from the solver log; no exploitability or met_target claim is made.",
      "required": ["method", "iterations", "per_seat", "worst_seat", "worst_seat_se_chips", "root_pot_chips", "worst_seat_se_pct_of_pot", "se_scope", "source"],
      "properties": {"method": {"const": "root_ev_standard_error"}, "iterations": {"type": "integer", "minimum": 1},
        "per_seat": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["seat", "root_ev_chips", "se_chips"], "properties": {"seat": {"$ref": "#/$defs/seat"}, "root_ev_chips": {"type": "number"}, "se_chips": {"type": "number", "minimum": 0}}}},
        "worst_seat": {"$ref": "#/$defs/seat"}, "worst_seat_se_chips": {"type": "number", "minimum": 0},
        "root_pot_chips": {"type": "number", "exclusiveMinimum": 0}, "worst_seat_se_pct_of_pot": {"type": "number", "minimum": 0},
        "se_scope": {"type": "string"}, "source": {"type": "string"}},
      "not": {"anyOf": [{"required": ["met_target"]}, {"required": ["exploitability_pct_of_pot"]}]}},
    "convergence_expl": {"type": "object", "description": "Exact CFR engines (TexasSolver): the v1 exploitability certificate.",
      "required": ["method", "iterations", "exploitability_pct_of_pot", "accuracy_target_pct_of_pot", "met_target", "source"],
      "properties": {"method": {"const": "exploitability"}, "iterations": {"type": "integer", "minimum": 1}, "exploitability_pct_of_pot": {"type": "number"},
        "accuracy_target_pct_of_pot": {"type": "number"}, "met_target": {"const": true}, "source": {"enum": ["tmp_log.txt", "solve_stdout.log"]}}},
    "decision_node": {"type": "object", "required": ["path", "actor", "actions", "frequencies", "evs"],
      "properties": {
        "path": {"type": "array", "items": {"type": "string"}, "description": "[] = root. Preflop entries are SEAT:ACTION."},
        "actor": {"enum": ["SB", "BB", "UTG", "HJ", "CO", "BTN", "ip", "oop"]},
        "actions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "frequencies": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/vector"},
          "description": "class169 spots: exactly the 169 classes (AA, AKs, AKo, ... 22); combo spots: AhKd-style combos not on the board. Vectors align with actions and sum to 1."},
        "evs": {"oneOf": [{"type": "null"}, {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/vector"}}]},
        "solver_node_id": {"type": "integer"}, "action_detail": {"type": "object"}}},
    "spot": {"type": "object",
      "required": ["spot_id", "street", "board", "table", "positions", "hand_keying", "pot", "stacks", "solver", "solver_settings", "run_date", "run_date_source", "convergence", "decision_nodes", "provenance", "verification"],
      "properties": {
        "spot_id": {"type": "string"},
        "street": {"enum": ["preflop", "flop", "turn", "river"]},
        "board": {"type": "array", "minItems": 0, "maxItems": 5, "items": {"type": "string", "pattern": "^[2-9TJQKA][cdhs]$"}, "description": "preflop: [] ; flop 3, turn 4, river 5"},
        "table": {"type": "object", "required": ["format"], "properties": {"format": {"enum": ["6max", "heads_up"]}}},
        "positions": {"type": "object", "description": "preflop: {seats:[SB,BB,UTG,HJ,CO,BTN], first_to_act}; postflop: {ip, oop} seat names"},
        "hand_keying": {"enum": ["class169", "combo"], "description": "preflop = class169, postflop = combo"},
        "ranges": {"type": "object"},
        "pot": {"type": "number", "exclusiveMinimum": 0},
        "stacks": {"type": "object", "required": ["effective_stack"]},
        "rake": {"type": "object"}, "bet_sizes": {"type": "object"}, "accuracy_target": {"type": "number"},
        "solver": {"$ref": "#/$defs/solver"}, "solver_settings": {"type": "object"},
        "run_date": {"type": "string", "format": "date-time"}, "run_date_source": {"type": "string"},
        "convergence": {"oneOf": [{"$ref": "#/$defs/convergence_se"}, {"$ref": "#/$defs/convergence_expl"}]},
        "decision_nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/decision_node"}},
        "provenance": {"type": "object", "required": ["output_file", "output_sha256"]},
        "verification": {"enum": ["single_source", "verified"], "description": "Extractor writes single_source; only the independent validator may set verified."},
        "synthetic_test_data": {"const": true}}}
  }
}
